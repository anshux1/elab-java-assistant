{
  "manifest_version": 3,
  "name": "eLab Java Assistant",
  "description": "Solve Java problems and copy problem statements on SRM eLab.",
  "version": "2.1.1",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://elab-solver.elab-solver-worker.workers.dev/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dld.srmist.edu.in/fshelab/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dld.srmist.edu.in/fshelab/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "114",
  "homepage_url": "https://github.com/anshux1/elab-java-assistant"
}
